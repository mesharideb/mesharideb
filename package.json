{
  "name": "mesharideb-contribution-skyline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "fetch:data": "node scripts/fetch-contributions.mjs",
    "render:profile": "node scripts/render-profile.mjs",
    "refresh": "npm run fetch:data && npm run build && npm run render:profile",
    "test": "node --import tsx --test src/lib/*.test.ts scripts/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
